[Unit]
Description=Mnote capture sync API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=heartnote-capture
Group=heartnote-capture
EnvironmentFile=/etc/heartnote-capture/server.env
WorkingDirectory=/opt/heartnote-capture
ExecStart=/opt/heartnote-capture/.venv/bin/heartnote-capture-api
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/heartnote-capture

[Install]
WantedBy=multi-user.target
