MNOTE_TRANSCRIPT_TOKEN=replace-with-random-secret-at-least-32-characters
MNOTE_TRANSCRIPT_DATA=/var/lib/mnote-transcript
MNOTE_TRANSCRIPT_MODEL=/opt/mnote-transcript/models/faster-whisper-small
# Exact HTTPS hosts for direct media, including any redirect destination. Empty disables it.
MNOTE_TRANSCRIPT_AUDIO_HOSTS=media.example.org
# Optional own CC0 fixture; these public endpoints expose only this exact configured file.
MNOTE_TRANSCRIPT_DEMO_AUDIO=/opt/mnote-transcript/demo/sample.wav
MNOTE_TRANSCRIPT_PUBLIC_URL=https://chenyu.online/mnote-transcript-api
# For the optional anonymous gateway only. Use a different secret from the API token.
MNOTE_TRANSCRIPT_SESSION_SECRET=replace-with-independent-random-secret-at-least-32-bytes
MNOTE_TRANSCRIPT_GATEWAY_DATA=/var/lib/mnote-transcription-public
MNOTE_TRANSCRIPT_PUBLIC_ORIGIN=https://chenyu.online
