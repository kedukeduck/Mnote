<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="标签 · 可选" android:textSize="13sp" android:textColor="@color/ink"
        android:fontFamily="sans-serif-medium" />
    <Button android:id="@+id/capture_tags_choose" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="选择已有" android:textSize="13sp" android:background="@android:color/transparent" />
    </LinearLayout>
    <EditText android:id="@+id/capture_tags_input" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:hint="例如：灵感，工作，待读" android:inputType="text" android:singleLine="true"
        android:importantForAutofill="no" android:saveEnabled="false"
        android:background="@drawable/bg_input" android:padding="16dp" android:textSize="14sp" />
    <LinearLayout android:id="@+id/capture_tags_picker" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone" android:paddingTop="8dp">
        <EditText android:id="@+id/capture_tags_search" android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="搜索已有标签" android:textSize="14sp" android:inputType="text" android:singleLine="true"
            android:background="@drawable/bg_input" android:padding="12dp" android:importantForAutofill="no" android:saveEnabled="false" />
        <TextView android:id="@+id/capture_tags_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/ink_muted" android:paddingVertical="8dp" />
        <LinearLayout android:id="@+id/capture_tags_options" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button android:id="@+id/capture_tags_more" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="显示更多标签" android:background="@android:color/transparent" />
    </LinearLayout>
</LinearLayout>
