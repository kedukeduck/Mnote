<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:fitsSystemWindows="true" android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
            android:paddingTop="8dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/app_name" android:textColor="@color/ink" android:textSize="21sp"
                    android:fontFamily="sans-serif-medium" />
                <Button android:id="@+id/capture_sync_settings_button" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/capture_account_short"
                    android:contentDescription="@string/capture_sync_settings_button" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="@string/capture_inbox_title"
                android:textColor="@color/ink" android:textSize="32sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
            <EditText android:id="@+id/capture_search" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/capture_search_hint" android:singleLine="true"
                android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp"
                android:inputType="text" android:imeOptions="actionSearch" android:textSize="14sp"
                android:importantForAutofill="no" />
            <RadioGroup android:id="@+id/capture_filter_group" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:checkedButton="@id/capture_filter_all" android:orientation="horizontal">
                <RadioButton android:id="@+id/capture_filter_all" style="@style/CaptureSegment" android:text="@string/capture_filter_all" />
                <RadioButton android:id="@+id/capture_filter_excerpt" style="@style/CaptureSegment" android:text="@string/capture_filter_excerpt" />
                <RadioButton android:id="@+id/capture_filter_thought" style="@style/CaptureSegment" android:text="@string/capture_kind_thought" />
                <RadioButton android:id="@+id/capture_filter_todo" style="@style/CaptureSegment" android:text="@string/capture_kind_todo" />
            </RadioGroup>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/capture_recent_title" android:textSize="18sp" android:textColor="@color/ink"
                    android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/capture_record_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/ink_muted" android:textSize="12sp" />
                <Button android:id="@+id/capture_refresh_button" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minWidth="56dp"
                    android:text="@string/capture_refresh" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/capture_refresh_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite" android:text="@string/capture_refresh_hint"
                android:textColor="@color/ink_muted" android:textSize="12sp" />
            <LinearLayout android:id="@+id/capture_empty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:background="@drawable/bg_card" android:gravity="center" android:orientation="vertical"
                android:paddingTop="36dp" android:paddingBottom="36dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_quick_note" android:tint="@color/ink_muted"
                    android:importantForAccessibility="no" android:contentDescription="@null" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:gravity="center" android:text="@string/capture_empty_title"
                    android:textColor="@color/ink" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center" android:text="@string/capture_empty_detail"
                    android:textColor="@color/ink_muted" android:textSize="13sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/capture_records" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/capture_sync_status" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp"
                    android:accessibilityLiveRegion="polite" android:text="@string/capture_sync_status_disabled"
                    android:textColor="@color/ink_muted" android:textSize="12sp" android:lineSpacingExtra="3dp" />
                <Button android:id="@+id/capture_sync_all_button" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minWidth="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:text="@string/capture_sync_all_button" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/capture_setup_toggle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
                android:layout_marginTop="12dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:background="@drawable/bg_button_secondary" android:clickable="true" android:focusable="true"
                android:text="@string/capture_setup_expand" android:textColor="@color/coral" android:textSize="13sp" />
            <LinearLayout android:id="@+id/capture_setup_panel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="18dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/capture_shortcuts_intro" android:textColor="@color/ink"
                    android:textSize="15sp" android:lineSpacingExtra="4dp" />
                <Button android:id="@+id/capture_add_note_tile_button" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="@string/quick_note_add_tile_button" />
                <Button android:id="@+id/capture_add_tile_button" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/capture_add_tile_button" />
                <TextView android:id="@+id/capture_access_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite" android:textColor="@color/ink_muted"
                    android:textSize="13sp" android:lineSpacingExtra="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/capture_privacy_detail"
                    android:textColor="@color/ink_muted" android:textSize="12sp" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/capture_source_settings_button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/capture_source_settings" android:textColor="@color/coral"
                android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/capture_action_dock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false"
        android:background="@color/card" android:elevation="4dp"
        android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <Button android:id="@+id/capture_quick_note_button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_quick_note" android:drawableTint="@color/white" android:drawablePadding="6dp"
            android:text="@string/capture_quick_note_button" android:textColor="@color/white" android:textSize="16sp" />
        <Button android:id="@+id/capture_start_button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp"
            android:layout_marginStart="6dp" android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_capture_tile" android:drawableTint="@color/coral" android:drawablePadding="6dp"
            android:text="@string/capture_filter_excerpt" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
