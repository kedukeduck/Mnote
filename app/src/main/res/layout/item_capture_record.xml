<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/capture_item_image"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:adjustViewBounds="false"
        android:background="#FF1C1B1E"
        android:contentDescription="@string/capture_item_image_description"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/capture_item_kind"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_capture_kind"
            android:gravity="center"
            android:minWidth="62dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/coral_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/capture_item_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/capture_item_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/capture_item_exact_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_capture_source_excerpt"
        android:lineSpacingExtra="3dp"
        android:maxLines="8"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/capture_item_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/ink_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/capture_item_sync_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/capture_sync_item_local"
        android:textColor="@color/ink_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
