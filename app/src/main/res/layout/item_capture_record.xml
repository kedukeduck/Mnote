<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:orientation="vertical">
    <TextView android:id="@+id/journal_item_day" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="20dp" android:paddingBottom="12dp" android:textSize="14sp" android:textColor="@color/copper" android:fontFamily="sans-serif-medium" android:visibility="gone" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <LinearLayout android:id="@+id/journal_item_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="16dp" android:gravity="top">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/capture_item_comment" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp" android:textColor="@color/ink" android:textSize="17sp" android:maxLines="3" android:ellipsize="end" />
            <TextView android:id="@+id/capture_item_exact_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/ink" android:textSize="17sp" android:visibility="gone" />
            <TextView android:id="@+id/capture_item_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/ink_muted" android:textSize="13sp" />
            <TextView android:id="@+id/capture_item_sync_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/ink_muted" android:textSize="13sp" android:visibility="gone" />
            <TextView android:id="@+id/capture_item_kind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/capture_item_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/capture_item_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:id="@+id/capture_item_image" android:layout_width="84dp" android:layout_height="96dp" android:layout_marginStart="16dp"
            android:background="@drawable/bg_capture_text_preview" android:contentDescription="@string/capture_item_image_description"
            android:scaleType="centerCrop" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
