<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cream" android:fitsSystemWindows="true" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/capture_editor_cancel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="@string/capture_cancel" android:textColor="@color/coral" android:textSize="16sp" />
        <TextView android:id="@+id/capture_editor_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:gravity="center" android:text="@string/capture_editor_screen_title"
            android:textColor="@color/ink" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
        <Button android:id="@+id/capture_editor_save" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minWidth="68dp"
            android:background="@drawable/bg_button_primary" android:text="@string/capture_save"
            android:textColor="@color/white" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView android:id="@+id/capture_editor_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
        android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="6dp" android:paddingBottom="12dp" android:text="@string/capture_loading_image"
        android:textColor="@color/ink_muted" android:textSize="12sp" />

    <FrameLayout android:id="@+id/capture_evidence_container" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
        <FrameLayout android:id="@+id/capture_markup_container" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@drawable/bg_canvas"
            android:visibility="gone">
            <com.codex.mnote.CaptureMarkupView android:id="@+id/capture_markup_view"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <ScrollView android:id="@+id/capture_source_text_container" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@drawable/bg_capture_text_preview"
            android:fillViewport="true" android:padding="20dp" android:visibility="gone">
            <TextView android:id="@+id/capture_source_text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:lineSpacingExtra="6dp"
                android:textColor="@color/ink" android:textIsSelectable="true" android:textSize="16sp" />
        </ScrollView>
        <ProgressBar android:id="@+id/capture_editor_progress" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_gravity="center" android:indeterminateTint="@color/coral" />
    </FrameLayout>

    <HorizontalScrollView android:id="@+id/capture_tool_row" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:id="@+id/capture_tool_select" style="@style/CaptureToolChip" android:text="@string/capture_tool_select" />
            <TextView android:id="@+id/capture_tool_pen" style="@style/CaptureToolChip" android:text="@string/capture_tool_pen" />
            <TextView android:id="@+id/capture_tool_highlighter" style="@style/CaptureToolChip" android:text="@string/capture_tool_highlighter" />
            <TextView android:id="@+id/capture_tool_undo" style="@style/CaptureToolChip" android:text="@string/capture_tool_undo" />
            <TextView android:id="@+id/capture_tool_whole" style="@style/CaptureToolChip" android:text="@string/capture_tool_whole" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/capture_composer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
        <include layout="@layout/capture_source_link" />
        <CheckBox android:id="@+id/capture_retain_image_context" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:visibility="gone"
            android:text="@string/capture_retain_image_context" android:textSize="14sp" />
        <LinearLayout android:id="@+id/capture_text_context_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <CheckBox android:id="@+id/capture_retain_text_context" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/capture_retain_text_context" android:textSize="13sp" />
            <Button android:id="@+id/capture_text_context_edit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/capture_text_context_edit" android:textSize="13sp" />
        </LinearLayout>
        <RadioGroup android:id="@+id/capture_kind_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:checkedButton="@id/capture_kind_comment"
            android:background="@drawable/bg_segments" android:padding="3dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <RadioButton android:id="@+id/capture_kind_comment" style="@style/CaptureSegment" android:text="@string/capture_kind_comment" />
            <RadioButton android:id="@+id/capture_kind_thought" style="@style/CaptureSegment" android:text="@string/capture_kind_thought" />
            <RadioButton android:id="@+id/capture_kind_todo" style="@style/CaptureSegment" android:text="@string/capture_kind_todo" />
        </RadioGroup>
        <EditText android:id="@+id/capture_comment_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/bg_input" android:gravity="top|start"
            android:hint="@string/capture_comment_hint" android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="flagNoExtractUi" android:importantForAutofill="no"
            android:maxLength="20000" android:maxLines="4"
            android:minHeight="84dp" android:padding="16dp" android:lineSpacingExtra="5dp"
            android:textColor="@color/ink" android:textColorHint="@color/ink_muted" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
