<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/capture_editor_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/capture_cancel"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="58dp"
            android:text="@string/capture_cancel"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/capture_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/capture_editor_screen_title"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/capture_editor_save"
            android:layout_width="76dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/capture_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/capture_editor_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/capture_loading_image"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:minHeight="220dp">

        <FrameLayout
            android:id="@+id/capture_markup_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF1C1B1E"
            android:visibility="gone">

            <com.codex.mnote.CaptureMarkupView
                android:id="@+id/capture_markup_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/capture_source_text_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_capture_text_preview"
            android:fillViewport="true"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/capture_source_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="16sp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/capture_editor_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/coral" />
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/capture_tool_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/capture_tool_select"
                style="@style/CaptureToolChip"
                android:text="@string/capture_tool_select" />

            <TextView
                android:id="@+id/capture_tool_pen"
                style="@style/CaptureToolChip"
                android:layout_marginStart="5dp"
                android:text="@string/capture_tool_pen" />

            <TextView
                android:id="@+id/capture_tool_highlighter"
                style="@style/CaptureToolChip"
                android:layout_marginStart="5dp"
                android:text="@string/capture_tool_highlighter" />

            <TextView
                android:id="@+id/capture_tool_undo"
                style="@style/CaptureToolChip"
                android:layout_marginStart="5dp"
                android:text="@string/capture_tool_undo" />

            <TextView
                android:id="@+id/capture_tool_whole"
                style="@style/CaptureToolChip"
                android:layout_marginStart="5dp"
                android:text="@string/capture_tool_whole" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <RadioGroup
            android:id="@+id/capture_kind_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@id/capture_kind_comment"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/capture_kind_comment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:buttonTint="@color/coral"
                android:gravity="center_vertical"
                android:text="@string/capture_kind_comment"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/capture_kind_thought"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:buttonTint="@color/coral"
                android:gravity="center_vertical"
                android:text="@string/capture_kind_thought"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/capture_kind_todo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:buttonTint="@color/coral"
                android:gravity="center_vertical"
                android:text="@string/capture_kind_todo"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/capture_comment_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/capture_comment_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="20000"
            android:maxLines="5"
            android:minHeight="82dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
