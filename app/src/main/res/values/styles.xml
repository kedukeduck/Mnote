<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Mnote" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:alertDialogTheme">@style/Theme.Mnote.Dialog</item>
        <item name="android:editTextStyle">@style/MnoteInput</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorControlHighlight">@color/line</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:buttonStyle">@style/MnoteButton</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>

    <style name="Theme.Mnote" parent="Base.Theme.Mnote" />

    <style name="MnoteContextSwitch" parent="android:style/Widget.Material.Light.CompoundButton.Switch">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:thumb">@drawable/bg_switch_thumb</item>
        <item name="android:track">@drawable/bg_switch_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:switchPadding">12dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:showText">false</item>
    </style>

    <style name="Theme.Mnote.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MnoteDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MnoteDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/MnoteDialogButton</item>
        <item name="android:editTextStyle">@style/MnoteInput</item>
    </style>

    <style name="MnoteDialogButton" parent="android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MnoteInput" parent="android:style/Widget.Material.Light.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Theme.CaptureTrigger" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:alertDialogTheme">@style/Theme.Mnote.Dialog</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="CaptureToolChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_drawer_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MnoteButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="CaptureSegment" parent="android:style/Widget.Material.Light.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
