    <string name="capture_sync_settings_title">Capture Server 同步</string>
    <string name="capture_sync_settings_back">返回</string>
    <string name="capture_sync_settings_intro">同步是可选项。本机记录始终先保存成功，再由一个串行后台队列逐条上传；网络或服务端失败不会删除本地记录。</string>
    <string name="capture_sync_url_label">Capture Server URL</string>
    <string name="capture_sync_url_hint">https://capture.example.com</string>
    <string name="capture_sync_url_rule">HTTPS 可以连接任意主机；HTTP 只允许 localhost 或 10.x、172.16–31.x、192.168.x 等私网字面地址。HTTP 不加密摘录和 Token，仅应在你信任的隔离网络中使用。URL 不可包含用户名、密码、查询参数或片段。</string>
    <string name="capture_sync_token_label">写 Token</string>
    <string name="capture_sync_token_hint">粘贴服务端专用写 Token</string>
    <string name="capture_sync_token_saved_hint">已加密保存；留空表示沿用，不会在页面回显</string>
    <string name="capture_sync_token_rule">Token 使用 Android Keystore 的 AES-GCM 密钥加密后保存；界面、普通日志和错误信息都不会输出 Token。</string>
    <string name="capture_sync_ai_label">新记录默认 AI 可见性</string>
    <string name="capture_sync_ai_deny">禁止 AI 读取</string>
    <string name="capture_sync_ai_local_only">仅本人/第一方读取，不供 AI（默认）</string>
    <string name="capture_sync_ai_remote_no_memory">允许远程 AI，本次读取不留记忆</string>
    <string name="capture_sync_ai_remote_memory">允许远程 AI，并允许形成长期记忆</string>
    <string name="capture_sync_ai_rule">“禁止 AI 读取”和默认的“仅本人/第一方读取”都不会进入只读 AI 接口；只有你主动选择两项“远程 AI”策略后，只读 AI 凭据才可看到对应新记录。这个默认值不会自动改写旧记录。</string>
    <string name="capture_sync_settings_save">保存并同步本机记录</string>
    <string name="capture_sync_settings_configured">当前已配置。出于安全原因，已保存的 Token 不会回显。</string>
    <string name="capture_sync_settings_not_configured">尚未形成完整配置；保存前不会发起任何网络请求。</string>
    <string name="capture_sync_settings_saved">同步设置已安全保存，本机记录已加入队列。</string>
    <string name="capture_sync_settings_invalid">设置未保存。请检查 URL、Token 和 AI 可见性。</string>
    <string name="capture_sync_settings_security_error">Android Keystore 无法加密或读取写 Token；设置未保存。</string>
    <string name="capture_sync_settings_disable">停用同步并删除凭证</string>
