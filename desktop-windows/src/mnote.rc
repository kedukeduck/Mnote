#include <windows.h>
1 RT_MANIFEST "mnote.manifest"
1 VERSIONINFO
FILEVERSION 1,7,0,0
PRODUCTVERSION 1,7,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Mnote"
      VALUE "FileDescription", "Mnote personal knowledge library"
      VALUE "FileVersion", "1.7.0-test"
      VALUE "InternalName", "mnote"
      VALUE "OriginalFilename", "mnote.exe"
      VALUE "ProductName", "Mnote"
      VALUE "ProductVersion", "1.7.0-test"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
